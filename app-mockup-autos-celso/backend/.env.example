# ============================================
# Variables de entorno - Backend API
# ============================================
# Copia este archivo como .env y ajusta los valores

# Ruta al modelo Random Forest (.pkl)
# En desarrollo local, apunta al modelo del proyecto
MODEL_PATH=../../models/random_forest/model.pkl

# Ruta al encoding map (target encoding de 'model')
ENCODING_MAP_PATH=../../data/processed/model_encoding_map.csv

# Puerto del servidor
PORT=8000
HOST=0.0.0.0

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Tasa de cambio USD → CLP
EXCHANGE_RATE_USD_CLP=950
