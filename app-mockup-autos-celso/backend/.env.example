# ============================================================
# Variables de entorno — Backend API
# Copia este archivo como .env y ajusta los valores
# ============================================================

# ── Artefactos ML ──────────────────────────────────────────
# Ruta al modelo Random Forest serializado (.pkl)
MODEL_PATH=../../models/random_forest/model.pkl

# Ruta al encoding map (Target Encoding de la columna 'model')
ENCODING_MAP_PATH=../../data/processed/model_encoding_map.csv

# ── Servidor ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (sin espacios)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Parámetros de negocio ───────────────────────────────────
# Tasa de cambio USD → CLP (actualizar según mercado)
EXCHANGE_RATE_USD_CLP=950

# ── Logging ─────────────────────────────────────────────────
# Valores: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
